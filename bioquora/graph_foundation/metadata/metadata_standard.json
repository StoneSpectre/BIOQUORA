{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioquora.org/schemas/v1.0/metadata_standard.json",
  "title": "BioGraph Core Metadata Envelope Standard",
  "type": "object",
  "required": [
    "created_at",
    "updated_at",
    "source",
    "license",
    "evidence_count",
    "confidence",
    "version",
    "quality_score",
    "maintainer",
    "extraction_pipeline",
    "model_version",
    "validation_status"
  ],
  "properties": {
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "license": { "type": "string", "const": "CC-BY-4.0" },
    "evidence_count": { "type": "integer", "minimum": 1 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "version": { "type": "string" },
    "quality_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "maintainer": { "type": "string" },
    "extraction_pipeline": { "type": "string" },
    "model_version": { "type": "string" },
    "validation_status": { "type": "string", "enum": ["PASSED_STAGE1_VERIFIED", "PENDING_CURATION", "REJECTED"] }
  }
}
